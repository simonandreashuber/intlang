-- lib for vectors

let map = \f v.
    let rec mapaux = \acc i.
        if i < veclen[v] then
            mapaux vecset[acc, f vecget[v, i], i] (i+1)
        else
            acc
        end
    in
    -- here shows a clear deficiency in the vector system as it is now
    -- in the case where we get an empty vector we have no way to get its type
    -- meaning we have two options:
    --      1. do the access to the first element and risk a runtime error (bad but only malfunctions in an edge case)
    --      2. return v or even a zero length vector of some fixed type which break the polymorphic power partially (very bad)
    -- I think there should probably just be a type type and then some vecgettype[v]
    mapaux vecmk[f vecget[v, 0], veclen[v]] 0

let map2 = \f v0 v1.
    let rec mapaux = \acc i.
        if i < veclen[v0] then
            mapaux vecset[acc, f vecget[v0, i] vecget[v1, i], i] (i+1)
        else
            acc
        end
    in
    -- for map2 of course v0 and v1 need to be of the same length but why bother
    -- if there does not even exist exception system, I mean there is not really a nice
    -- and generally useful default
    mapaux vecmk[f vecget[v0, 0] vecget[v1, 0], veclen[v0]] 0

let left_fold = \f acc v.
    let rec leftfoldaux = \acc i.
        if i < veclen[v] then
            leftfoldaux (f acc vecget[v, i]) (i+1)
        else
            acc
        end
    in
    leftfoldaux acc 0

let left_fold2 = \f acc v0 v1.
    let rec leftfoldaux = \acc i.
        if i < veclen[v0] then
            leftfoldaux (f acc vecget[v0, i] vecget[v1, i]) (i+1)
        else
            acc
        end
    in
    leftfoldaux acc 0

let right_fold = \f v acc.
    let rec rightfoldaux = \acc i.
        if 0 <= i then
            rightfoldaux (f (vecget[v, i]) acc) (i-1)
        else
            acc
        end
    in
    rightfoldaux acc (veclen[v]-1)

let iter = \f v.
    let rec iteraux = \f v i.
        if i < veclen[v] then
            (f vecget[v, i];
            iteraux f v (i+1))
        else
            ()
        end
    in
    iteraux f v 0

let concat = \v1 v2.
    let rec concataux = \acc i.
        if i < veclen[v2] then
            concataux (vecset[acc, vecget[v2, i], i + veclen[v1]]) (i+1)
        else 
            acc
        end
    in
    if veclen[v1] == 0 then
        v2
    else if veclen[v2] == 0 then
        v1
    else
        concataux (vecresz[v1, vecget[v2, 0], 0, veclen[v2]]) 0
    end end

let rev = \v.
    let rec revaux = \ vrev (i : i32) (irev :i32) .
        if 0 <= irev then
            revaux vecset[vrev, vecget[v,i], irev] (i+1) (irev-1)
        else
            vrev
        end in
    revaux vecmk[vecget[v,0], veclen[v]] 0 (veclen[v]-1)

    

let cmp = \cmpelm v1 v2.
    let n1 = veclen[v1] in
    let n2 = veclen[v2] in
    let rec cmpaux = \i.
        if i < n1 then
            let elcmp_val = cmpelm vecget[v1, i] vecget[v2, i] in
            if elcmp_val == 0 then
                cmpaux (i+1)
            else
                elcmp_val
            end
        else
            0
        end
    in
    if n1 < n2 then
        -1
    else if n1 > n2 then
        1
    else
        cmpaux 0
    end end