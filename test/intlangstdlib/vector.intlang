-- lib for vectors

let map = \f v.
    let rec mapaux = \acc i.
        if i < veclen[v] then
            mapaux vecset[acc, f vecget[v, i], i] (i+1)
        else
            v
        end
    in
    -- here shows a clear deficiency in the vector system as it is now
    -- in the case where we get an empty vector we have no way to get its type
    -- meaning we have two options:
    --      1. do the access to the first element and risk a runtime error (bad but only malfunctions in an edge case)
    --      2. return v or even a zero length vector of some fixed type which break the polymorphic power partially (very bad)
    -- I think there should probably just be a type type and then some vecgettype[v]
    mapaux vecmk[vecget[v, 0], veclen[v]] 0

let left_fold = \f acc v.
    let rec leftfoldaux = \acc i.
        if i < veclen[v] then
            leftfoldaux (f acc vecget[v, i]) (i+1)
        else
            acc
        end
    in
    leftfoldaux acc 0

let right_fold = \f v acc.
    let rec rightfoldaux = \acc i.
        if 0 <= i then
            rightfoldaux (f (vecget[v, i]) acc) (i-1)
        else
            acc
        end
    in
    rightfoldaux acc (veclen[v]-1)

let iter = \f v.
    let rec iteraux = \f v i.
        if i < veclen[v] then
            (f vecget[v, i];
            iteraux f v (i+1))
        else
            ()
        end
    in
    iteraux f v 0

let append = \v a. vecresz[v,a,0,1]

let concat = \v1 v2.
    let rec concataux = \acc i.
        if i < veclen[v2] then
            concataux (vecset[acc, vecget[v2, i], i + veclen[v1]]) (i+1)
        else 
            acc
        end
    in
    if veclen[v1] == 0 then
        v2
    else if veclen[v2] == 0 then
        v1
    else
        concataux (vecresz[v1, vecget[v2, 0], 0, veclen[v2]]) 0
    end end
    

let cmp = \cmpelm v1 v2.
    let rec cmpaux = \i.
        if i < veclen[v1] then
            if cmpelm vecget[v1, i] vecget[v2, i] then
                cmpaux (i+1)
            else
                0
            end
        else
            1
        end
    in
    if veclen[v1] == veclen[v2] then
        cmpaux 0
    else
        0
    end