-- storing vectors
-- Note: for now I implemented things to only work on vectors of ints

let bubblesort = \arr.
    let rec bubblesortaux = \arr. \len. \n. \i.
        let arrupdt =
                    let left = vecget[arr, i] in
                    let right = vecget[arr, n] in 
                    if left < right then 
                        arr
                    else
                        let temp = right in
                        let arr1 = vecset[arr, left, n] in
                        vecset[arr1, temp, i]
                    end 
        in
        if i < (len-1) then 
            bubblesortaux arrupdt len n (i+1)
        else if n < (len-1) then
            bubblesortaux arrupdt len (n+1) 0
        else 
            arr
        end end
    in
    bubblesortaux arr veclen[arr] 0 0