-- Expect: 1

include sort 
include search

let usorted = vec[35, 64, 3]
let sorted = sort.bubblesort usorted -- sorted is [3, 35, 64]

let main = 
  search.binarysearch sorted 64 -- idx 2
+ search.linearsearch usorted 64 -- idx 1
+ search.binarysearch sorted 100 -- idx -1
+ search.linearsearch usorted 100 -- idx -1
