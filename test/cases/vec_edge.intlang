include io
include vector

let printrows = \m. vector.iter io.writeln_i32vec m

let main = \() (
    let e = vecmk[1, 0] in
    let e2 = vecmk[1, 0, 3] in
    let e3 = vecmk[1, 3, 0] in
    let v = vec[1, 2, 3] in
    (
        -- empty vectors
        io.writeln_i32vec vec[veclen[e], veclen[e2], veclen[e3], veclen[vecget[e3, 2]], veclen[""]]; -- 0,0,0,0
        io.writeln_i32vec e; --[]
        io.writeln_i32vec vecextend[e, 5, 3];
        io.writeln_i32vec vecextend[e, 5, -2];
        io.writeln_i32vec vecextend[vec[], 4, 2];
        let ee = vecextend[e2, vecmk[2, 0], 2] in (io.writeln_i32vec vec[veclen[ee], veclen[vecget[ee, 1]]]); -- 2,0
        let ee3 = vecset[e3, vec[4], 1] in (printrows ee3);

        -- zero length slices and extends
        io.writeln_i32 veclen[vecslice[v, 0, 0]];
        io.writeln_i32 veclen[vecslice[v, 2, 0]];
        io.writeln_i32vec vecslice[v, 0, veclen[v]];
        io.writeln_i32vec vecextend[v, 9, 0];

        -- empty index lists and computed indices
        io.writeln_i32vec vecget[v];
        io.writeln_i32vec vecget[vec[v, vecset[v, 7, veclen[v] - 1]], 2 - 1];
        io.writeln_i32 vecget[vecset[vecmk[3, 2, 2], 4, 1, 0], 1 - 0, 2 * 0];

        -- 5D with a single element
        let one = vecmk[7, 1, 1, 1, 1, 1] in
        let one = vecset[one, 8, 0, 0, 0, 0, 0] in
        (io.writeln_i32vec vec[vecget[one, 0, 0, 0, 0, 0], veclen[vecget[one, 0, 0, 0, 0]]]);

        -- ragged literals
        let rg = vec[vec[vec[1, 2], vec[3]], vec[vec[]], vec[]] in
        (io.writeln_i32vec vec[veclen[rg], veclen[vecget[rg, 0]], veclen[vecget[rg, 0, 1]], veclen[vecget[rg, 1]], veclen[vecget[rg, 1, 0]], veclen[vecget[rg, 2]], vecget[rg, 0, 1, 0]]);

        -- empty vectors of functions and tuples
        let ef = vecextend[vecmk[\x. x, 0], \x. x + 1, 1] in
        let et = vecextend[vecmk[(1, 'a'), 0], (2, 'b'), 2] in
        let (x, c) = vecget[et, 1] in
        (io.writeln_i32vec vec[vecget[ef, 0] 1, veclen[et], x, i8_to_i32 c])
    )
)
