-- Expect: 6
-- goal here is to use some let in def that is polymorphic, in at least two different ways 
let test = \n.
    let appfun = \f. \x. (f x) in -- should be Forall t0,t1: (t0 -> t1) -> t0 -> t1
        if appfun (\x. x == 0) n then -- the constraints should force this instantiation to be: (int -> int) -> int -> int
            appfun (\x. veclen[x])  -- the constraints should force this one to be Forall t2: TVec[t2] -> int
        else
            appfun (\x. veclen[x]+1)  -- the if else should force both returns to be of the same type
        end;
test 2 (vecmk[0,5])