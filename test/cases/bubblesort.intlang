let bubblesort = \arr.
    let bubblesortaux = \arr. \len. \n. \i.
        let arrupdt = 
                    if vecget[arr, i] < vecget[arr, n] then 
                        arr
                    else
                        let temp = vecget[arr, n] in
                        let arr1 = vecset[arr, n, vecget[arr, i]] in
                        vecset[arr1, i, temp]
                    end 
        in
        if i < (len-1) then 
            bubblesortaux arrupdt len n (i+1)
        else if n < (len-1) then
            bubblesortaux arrupdt len (n+1) 0
        else 
            arrupdt
        end end
    in
    bubblesortaux arr veclen[arr] 0 0;

let thisvec = vec[5,4,3,2,1];
let sortedvec = bubblesort thisvec;

vecget[sortedvec, 0]