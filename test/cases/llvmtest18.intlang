-- Expect: 11
include str
let main =  \() str.writei32
    (let incvec = \amount. \v. 
        let vectorlen = veclen[v] in
        let rec helper = \v. \i. 
            if i < vectorlen then 
                let oldval = vecget[v, i] in
                helper vecset[v, oldval + amount, i] (i+1)
            else 
                v
            end 
        in 
        helper v 0
    in
    let somevec = vec[1,2,3,4,5,6] in
    let someincvec = incvec 5 somevec in
    vecget[someincvec, 5])