include io

let rec reduce1 = \n. \a. if n < 0 then a else reduce2 (n - 1) a end
and reduce2 = \n. \a. reduce1 (n - 2) a
let main = \() (
            io.write_ln (reduce1 10 "hello");
            io.writeln_i32 (reduce1 110 5)
        )
-- breaks the linear up monomorphism pass as main triggers a reduce1 mono version
-- which then triggers a reduce2 mono version (which is further down)
