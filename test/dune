(executable
 (name test_runner)
 (libraries intlang_lib str unix threads ocamlgraph)
 (modules test_runner tests)) ;(enabled_if false)

(rule
 (alias runtest)
 (deps (glob_files cases/*.intlang) (glob_files cases/inclfoldr/*.intlang) (glob_files intlangstdlib/*.intlang) ../bin/main.exe)
 (action (run %{exe:test_runner.exe} %{exe:../bin/main.exe})))

 ; Separate mode: runs with `dune build @test-ast` or `dune build @test-mir`
(rule
 (alias test-ast)
 (deps (glob_files cases/*.intlang) (glob_files cases/inclfoldr/*.intlang) (glob_files intlangstdlib/*.intlang) ../bin/main.exe)
 (action (run %{exe:test_runner.exe} --separate --interpast %{exe:../bin/main.exe})))

(rule
 (alias test-mir)
 (deps (glob_files cases/*.intlang) (glob_files cases/inclfoldr/*.intlang) (glob_files intlangstdlib/*.intlang) ../bin/main.exe)
 (action (run %{exe:test_runner.exe} --separate --interpmir %{exe:../bin/main.exe})))
